{
  "manifest_version": 3,
  "name": "Ozon JSON Scraper",
  "version": "1.0.0",
  "description": "Сбор данных о товарах Ozon в формате JSON",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://www.ozon.ru/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ozon.ru/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}